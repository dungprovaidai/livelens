# Node 24+. Local default runs at http://localhost:3001.
HOST=127.0.0.1
PORT=3001

# Required for Docker / a non-loopback server. Generate a long random value.
# Never commit .env or put the token in a URL.
APP_TOKEN=

# Optional Euler Stream signing API key, stored only on the server.
SIGN_API_KEY=

# Optional remote frontend origins, separated by commas; no trailing slash.
ALLOWED_ORIGINS=http://localhost:3001,http://127.0.0.1:3001,https://live-lens-dung.mail-1-hs-0765.chatgpt.site

# Without DATABASE_URL the local server uses ./data/livelens.sqlite.
# DATABASE_URL=postgres://livelens:password@localhost:5432/livelens

# Docker Compose: set a different long random database password.
POSTGRES_PASSWORD=
BIND_HOST=127.0.0.1

# Optional Caddy HTTPS profile, e.g. api.your-domain.com.
APP_DOMAIN=localhost
